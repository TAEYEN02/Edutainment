<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.koreait.edutainment">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Edutainment">
        <activity
            android:name=".RidePlayActivity"
            android:exported="false" />
        <activity
            android:name=".FoodPlayActivity"
            android:exported="false" />
        <activity
            android:name=".FamilyPlayActivity"
            android:exported="false" />
        <activity
            android:name=".GameListActivity"
            android:exported="false" />
        <activity
            android:name=".ProgressMenuActivity"
            android:exported="false" />
        <activity
            android:name=".ReadActivity"
            android:exported="false" />
        <activity
            android:name=".FamilyActivity"
            android:exported="false" />
        <activity
            android:name=".RideActivity"
            android:exported="false" />
        <activity
            android:name=".ListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.login.ListActivity"
            android:exported="false"
            android:label="@string/title_activity_list" />
        <activity
            android:name=".AniPlayActivity"
            android:exported="false" />
        <activity
            android:name=".AnimalActivity"
            android:exported="false" />
        <activity
            android:name=".ProgressActivity"
            android:exported="false" />
        <activity
            android:name=".IntroActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SigupActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="true"
            android:label="@string/title_activity_sigup"
            android:theme="@style/Theme.Edutainment.Fullscreen" />
        <activity
            android:name=".LoginActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="true"
            android:label="LoginActivity"
            android:theme="@style/Theme.Edutainment.Fullscreen" />
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:label="@string/title_activity_main"
            android:theme="@style/Theme.Edutainment.Fullscreen" />
    </application>

</manifest>