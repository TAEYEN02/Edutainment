<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:theme="@style/ThemeOverlay.Edutainment.FullscreenContainer"
    tools:context=".LoginActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="80dp"
            android:fontFamily="@font/font"
            android:textSize="19sp"
            android:textStyle="bold"
            android:text="카테고리" />

        <ImageButton
            android:id="@+id/anibtn1"
            android:layout_width="280dp"
            android:layout_height="130dp"
            android:layout_marginTop="30dp"
            android:layout_gravity="center_horizontal"
            android:padding="0dp"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/animal" />

        <ImageButton
            android:id="@+id/foodbtn2"
            android:layout_width="280dp"
            android:layout_height="130dp"
            android:layout_marginTop="25dp"
            android:layout_gravity="center_horizontal"
            android:padding="0dp"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/food" />

        <ImageButton
            android:id="@+id/ridebtn3"
            android:layout_width="280dp"
            android:layout_height="130dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="25dp"
            android:padding="0dp"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/ride" />


        <ImageButton
            android:id="@+id/familybtn5"
            android:layout_width="280dp"
            android:layout_height="130dp"
            android:layout_marginTop="25dp"
            android:layout_gravity="center_horizontal"
            android:padding="0dp"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/family" />

        <ImageButton
            android:id="@+id/thingsbtn7"
            android:layout_width="280dp"
            android:layout_height="130dp"
            android:layout_marginTop="25dp"
            android:layout_gravity="center_horizontal"
            android:padding="0dp"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/things" />

        <ImageButton
            android:id="@+id/naturebtn7"
            android:layout_width="280dp"
            android:layout_height="130dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="25dp"
            android:padding="0dp"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/nature" />

        <TextView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="25dp" />


    </LinearLayout>
</ScrollView>