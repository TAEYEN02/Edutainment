<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff"
    android:theme="@style/ThemeOverlay.Edutainment.FullscreenContainer"
    tools:context=".PlayActivity">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/StartButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|right"
        android:layout_marginBottom="32dp"
        android:background="@color/design_default_color_primary"
        android:text="TTS"
        android:textColor="@color/material_dynamic_neutral_variant100"
        android:textStyle="bold" />

    <Button
        android:id="@+id/STTbutton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_gravity="center|left"
        android:background="@color/design_default_color_primary"
        android:text="STT"
        android:textColor="@color/material_dynamic_neutral_variant100"
        android:textStyle="bold" />/>

    <Button
        android:id="@+id/TTS_STTbutton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_gravity="left|end"
        android:layout_marginStart="0dp"
        android:background="@color/design_default_color_primary"
        android:text="TTS+STT"
        android:textColor="@color/material_dynamic_neutral_variant100"
        android:textStyle="bold" />/>

</RelativeLayout>